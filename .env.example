# Required for production. Protects the publish endpoint from public use.
BUTTONPOST_SECRET=change-me

# X user-context auth.
# Fastest manual test path: OAuth 1.0a credentials generated for your own X account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Alternative: OAuth 2.0 *user* access token (not the application-only Bearer Token).
X_USER_ACCESS_TOKEN=
# Default is 280. Raise only if your posting account/API supports longer posts.
X_MAX_LENGTH=280

# DEV Community API key.
DEVTO_API_KEY=
# Optional comma-separated tags, for example: ai,webdev,blockchain
DEVTO_TAGS=
# Set to true while testing if you want ButtonPost to create DEV drafts.
DEVTO_DRAFT_ONLY=false

# Public Vercel Blob store used for shared X / DEV source images.
# Connecting a Blob store to the Vercel project normally creates this automatically.
BLOB_READ_WRITE_TOKEN=
