# Supabase Auth (Phase 6A). Public values only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Server-only HMAC secret for short-lived media upload tickets.
# Users never enter this value.
BUTTONPOST_SECRET=change-me

# 32-byte base64 key used to AES-GCM encrypt per-user platform credentials.
BUTTONPOST_CREDENTIAL_ENCRYPTION_KEY=

# Canonical public origin. Production example:
# https://buttonpost.vercel.app
BUTTONPOST_APP_URL=

# X OAuth application identity. Per-user access tokens are created through
# 3-legged OAuth and encrypted in Supabase.
X_API_KEY=
X_API_SECRET=
# Per-post limit. Content longer than this is mechanically split into a reply thread.
X_MAX_LENGTH=280
# Safety cap for automatic threads.
X_MAX_THREAD_POSTS=25

# DEV Community uses per-user API keys connected from ButtonPost Settings.
# Optional comma-separated tags, for example: ai,webdev,blockchain
DEVTO_TAGS=
# Set to true while testing if you want ButtonPost to create DEV drafts.
DEVTO_DRAFT_ONLY=false

# Public Vercel Blob store used for shared X / DEV source images.
# Preferred on Vercel: connect the store to the project so BLOB_STORE_ID is available
# and Vercel supplies the rotating VERCEL_OIDC_TOKEN at runtime.
BLOB_STORE_ID=
# Alternative legacy/non-OIDC credential:
BLOB_READ_WRITE_TOKEN=


# Paddle Billing (use sandbox values while developing)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=

# Keep false while validating Paddle Sandbox. Switch to true when the paid
# beta is ready to require Pro for X / DEV cloud publishing.
BUTTONPOST_REQUIRE_PRO=false
